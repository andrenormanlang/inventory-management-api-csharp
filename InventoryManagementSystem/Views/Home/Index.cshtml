@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="display-4">Inventory Management API</h1>
        <p class="lead">Explore the available API endpoints and interactive documentation.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary btn-lg" href="/swagger">Open Swagger UI</a>
            <a class="btn btn-outline-secondary btn-lg" href="/api/health">Health Check</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Products</h5>
                    <p class="card-text">Browse the products. .</p>
                    <a href="/api/product" class="mt-auto btn btn-sm btn-primary">Open Products API</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Categories</h5>
                    <p class="card-text">View  product categories .</p>
                    <a href="/api/category" class="mt-auto btn btn-sm btn-primary">Open Categories API</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Inventory</h5>
                    <p class="card-text">Check supplier details.</p>
                    <a href="/api/supplier" class="mt-auto btn btn-sm btn-primary">Open Suppliers API</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-md-6">
            <div class="card h-100 border-start border-5 border-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Authentication</h5>
                    <p class="card-text">If your API requires authentication, use the appropriate bearer token header when calling endpoints from Swagger or your client.</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-start border-5 border-success shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Quick Links</h5>
                    <p class="card-text mb-2">Useful links to get started:</p>
                    <a href="/swagger" class="btn btn-sm btn-outline-primary me-2">Swagger</a>
                    <a href="/api/health" class="btn btn-sm btn-outline-secondary">Health</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center mt-5 text-muted">Tip: Use the Swagger UI for interactive requests and example payloads.</footer>
</div>
